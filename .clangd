CompileFlags:
  Compiler: /usr/local/cuda/bin/nvcc
  Add:
    - --cuda-path=/usr/local/cuda
    - --cuda-gpu-arch=sm_89
    - -isystem/usr/local/cuda/include
    - -isystem/usr/local/cuda/targets/x86_64-linux/include
    - -isystem/usr/local/cuda/targets/x86_64-linux/include/cccl
    - "-xcuda"
    # report all errors
    - "-ferror-limit=0"
    - --std=c++20
    - "-D__INTELLISENSE__"
    - "-D__CLANGD__"
    - "-DCUDA_13_1_SM89_FEATURES_SUPPORTED"
    - "-D_LIBCUDACXX_STD_VER=13"
    - "-D__CUDACC_VER_MAJOR__=13"
    - "-D__CUDACC_VER_MINOR__=1"
    - "-D__CUDA_ARCH__=890"
    - "-D__CUDA_ARCH_FEAT_SM89_ALL"
    - "-Wno-invalid-constexpr"
  Remove:
    # drop duplicate plain -I for paths we re-add as -isystem above
    - "-I/usr/local/cuda/include"
    - "-I/usr/local/cuda/targets/x86_64-linux/include"
    - "-I/usr/local/cuda/targets/x86_64-linux/include/cccl"
    # strip CUDA fatbin args
    - "-Xfatbin*"
    # strip CUDA arch flags
    - "-gencode*"
    - "--generate-code*"
    # strip CUDA flags unknown to clang
    - "-ccbin*"
    - "--compiler-options*"
    - "--expt-extended-lambda"
    - "--extended-lambda"
    - "--expt-relaxed-constexpr"
    - "-forward-unknown-to-host-compiler"
    - "-Werror=cross-execution-space-call"
    - "--options-file*"
    - "-arch*"
    - "--restrict"
    - "--generate-line-info"
    - "-Xcompiler=-fPIC"
Hover:
  ShowAKA: No
InlayHints:
  Enabled: No
Diagnostics:
  Suppress:
    - "variadic_device_fn"
    - "attributes_not_allowed"
    - "deduction_guide_target_attr"
