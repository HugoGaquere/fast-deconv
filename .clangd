CompileFlags:
  Compiler: /usr/local/cuda/bin/nvcc
  Add:
    - --cuda-path=/usr/local/cuda
    - --cuda-gpu-arch=sm_89
    - -I/usr/local/cuda/include
    - "-xcuda"
    # report all errors
    - "-ferror-limit=0"
    - --cuda-gpu-arch=sm_90a
    - --std=c++20
    - "-D__INTELLISENSE__"
    - "-D__CLANGD__"
    - "-DCUDA_13_1_SM89_FEATURES_SUPPORTED"
    - "-D_LIBCUDACXX_STD_VER=13"
    - "-D__CUDACC_VER_MAJOR__=13"
    - "-D__CUDACC_VER_MINOR__=1"
    - "-D__CUDA_ARCH__=890"
    - "-D__CUDA_ARCH_FEAT_SM89_ALL"
    - "-Wno-invalid-constexpr"
    # project specific
    - -I/home/hugo/Documents/projects/fast-deconv/include/
    - -I/home/hugo/.conan2/p/emu5509528b36c04/s/include/core
    - -I/home/hugo/.conan2/p/emu5509528b36c04/s/include/cuda
    - -I/home/hugo/.conan2/p/emu5509528b36c04/s/include/python
    - -I/home/hugo/.conan2/p/fmt255f4d4faab0f/s/src/include
  Remove:
    # strip CUDA fatbin args
    - "-Xfatbin*"
    # strip CUDA arch flags
    - "-gencode*"
    - "--generate-code*"
    # strip CUDA flags unknown to clang
    - "-ccbin*"
    - "--compiler-options*"
    - "--expt-extended-lambda"
    - "--expt-relaxed-constexpr"
    - "-forward-unknown-to-host-compiler"
    - "-Werror=cross-execution-space-call"
Hover:
  ShowAKA: No
InlayHints:
  Enabled: No
Diagnostics:
  Suppress:
    - "variadic_device_fn"
    - "attributes_not_allowed"
